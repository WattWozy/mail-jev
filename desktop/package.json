{
  "name": "mail-sorter-desktop",
  "version": "0.1.0",
  "description": "Mail Sorter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.jev.mailsorter",
    "productName": "Buzon",
    "directories": { "buildResources": "assets" },
    "files": [
      "main.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "build/app.jar",
        "to": "app.jar"
      },
      {
        "from": "build/jre",
        "to": "jre"
      }
    ],
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "mac": { "target": "dmg", "icon": "assets/icon.png" },
    "linux": { "target": "AppImage", "icon": "assets/icon.png" },
    "nsis": { "shortcutName": "Buzon" }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
